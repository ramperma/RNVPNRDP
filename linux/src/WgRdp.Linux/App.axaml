<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="WgRdp.App"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme />

    <Style Selector="Window">
      <Setter Property="Background" Value="#10151C"/>
      <Setter Property="Foreground" Value="#E7EEF6"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style Selector="TextBox">
      <Setter Property="Background" Value="#0E141B"/>
      <Setter Property="Foreground" Value="#E7EEF6"/>
      <Setter Property="MinHeight" Value="34"/>
      <Setter Property="Padding" Value="8,6"/>
    </Style>

    <Style Selector="TextBlock.field">
      <Setter Property="Foreground" Value="#8B9BB0"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,10,0,4"/>
    </Style>

    <Style Selector="TextBlock.section">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style Selector="Button">
      <Setter Property="MinHeight" Value="34"/>
      <Setter Property="Padding" Value="14,8"/>
    </Style>

    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#1F8A70"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style Selector="Button.primary:pointerover">
      <Setter Property="Background" Value="#26A584"/>
    </Style>

    <Style Selector="Button.danger">
      <Setter Property="Foreground" Value="#E06C75"/>
    </Style>

    <Style Selector="Button.ghost">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#8B9BB0"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="MinHeight" Value="28"/>
      <Setter Property="Padding" Value="10,6"/>
    </Style>

    <Style Selector="CheckBox">
      <Setter Property="Margin" Value="0,8,0,0"/>
    </Style>
  </Application.Styles>
</Application>
