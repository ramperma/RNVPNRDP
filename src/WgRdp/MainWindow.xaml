<Window x:Class="WgRdp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wfi="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
        Title="WG-RDP"
        Width="1180" Height="760"
        MinWidth="960" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/app.ico"
        Background="{StaticResource BgApp}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="56"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Cabecera -->
    <Border Grid.Row="0" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
      <DockPanel Margin="18,0">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Image Source="/Assets/app-icon-96.png" Width="24" Height="24" Margin="0,0,10,0"
                 RenderOptions.BitmapScalingMode="HighQuality"/>
          <TextBlock Text="WG-RDP" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <TextBlock Text="  Acceso remoto por WireGuard" Foreground="{StaticResource TextMuted}"
                     VerticalAlignment="Center" FontSize="12"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Border x:Name="StatusBadge" CornerRadius="12" Padding="10,5" Background="#222C38" Margin="0,0,12,0">
            <StackPanel Orientation="Horizontal">
              <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#8B9BB0" Margin="0,0,8,0"/>
              <TextBlock x:Name="StatusText" Text="Listo" FontSize="12" Foreground="{StaticResource Text}"
                         MaxWidth="420" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
          </Border>
          <Button x:Name="SaveButton" Content="Guardar perfil" Click="OnSaveProfile" Margin="0,0,8,0"/>
          <Button x:Name="CancelButton" Content="Cancelar" Click="OnCancel" Style="{StaticResource DangerButton}"
                  IsEnabled="False" Margin="0,0,8,0"/>
          <Button x:Name="ConnectButton" Content="Conectar y abrir RDP" Click="OnConnect"
                  Style="{StaticResource PrimaryButton}"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="340"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- Perfil -->
      <Border Grid.Column="0" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18,14">
          <StackPanel>
            <TextBlock Text="Conexión" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>

            <TextBlock Text="Perfil" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
            <ComboBox x:Name="ProfilePicker" SelectionChanged="OnProfileSelected"/>

            <TextBlock Text="Nombre" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="ProfileNameBox"/>

            <TextBlock Text="Servidor RDP" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="RdpHostBox"/>

            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="90"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Text="Usuario" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="UserBox"/>
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="Puerto" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="RdpPortBox" Text="3389"/>
              </StackPanel>
            </Grid>

            <TextBlock Text="Dominio" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="DomainBox"/>

            <TextBlock Text="Contraseña" Style="{StaticResource FieldLabel}"/>
            <PasswordBox x:Name="PasswordBox"/>
            <TextBlock Text="Se guarda en el almacén de credenciales de Windows"
                       Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>

            <TextBlock Text="Túnel WireGuard" Style="{StaticResource SectionTitle}" Margin="0,22,0,4"/>

            <TextBlock Text="Nombre del túnel" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="TunnelNameBox"/>

            <TextBlock Text="IP VPN del servidor (opcional)" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="ServerVpnIpBox"/>

            <CheckBox x:Name="RemoveTunnelCheck" Content="Eliminar el túnel al cerrar la sesión"/>

            <TextBlock Text="Recursos locales" Style="{StaticResource SectionTitle}" Margin="0,22,0,8"/>
            <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource Line}"
                    BorderThickness="1" CornerRadius="6" Padding="12,10">
              <StackPanel>
                <TextBlock Text="Usar en la sesión remota"
                           Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,0,0,4"
                           TextWrapping="Wrap"/>
                <CheckBox x:Name="RedirectPrintersCheck" Content="Impresoras locales"
                          IsChecked="True" Margin="0,6,0,0"/>
                <CheckBox x:Name="RedirectDrivesCheck" Content="Discos locales"
                          IsChecked="True" Margin="0,8,0,0"/>
                <CheckBox x:Name="RedirectClipboardCheck" Content="Portapapeles local"
                          IsChecked="True" Margin="0,8,0,0"/>
              </StackPanel>
            </Border>

            <Button x:Name="WizardButton" Content="Asistente de configuración"
                    Click="OnWizard" Margin="0,16,0,8" HorizontalAlignment="Stretch"/>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <!-- Remoto + registro -->
      <Grid Grid.Column="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="220" MinHeight="140"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#0B1016" Margin="12,12,12,0" CornerRadius="6"
                BorderBrush="{StaticResource Line}" BorderThickness="1">
          <Grid>
            <wfi:WindowsFormsHost x:Name="RdpHost" Visibility="Collapsed"/>
            <StackPanel x:Name="PlaceholderPanel" HorizontalAlignment="Center" VerticalAlignment="Center">
              <TextBlock Text="Escritorio remoto" FontSize="16" FontWeight="SemiBold"
                         HorizontalAlignment="Center"/>
              <TextBlock x:Name="PlaceholderText"
                         Text="Pulse Conectar para iniciar la sesión."
                         Foreground="{StaticResource TextMuted}"
                         HorizontalAlignment="Center" Margin="0,8,0,0"/>
            </StackPanel>
          </Grid>
        </Border>

        <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch"
                      Background="{StaticResource BgApp}" Cursor="SizeNS"/>

        <Border Grid.Row="2" Margin="12,0,12,12" Background="{StaticResource BgLog}"
                CornerRadius="6" BorderBrush="{StaticResource Line}" BorderThickness="1">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="36"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="12,0">
              <TextBlock Text="Registro de conexión" VerticalAlignment="Center"
                         FontWeight="SemiBold" FontSize="12"/>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Copiar" Click="OnCopyLog" Style="{StaticResource GhostButton}"/>
                <Button Content="Limpiar" Click="OnClearLog" Style="{StaticResource GhostButton}"/>
              </StackPanel>
            </DockPanel>

            <ListBox x:Name="LogList" Grid.Row="1"
                     Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     FontFamily="Cascadia Mono, Consolas, Courier New"
                     FontSize="12"
                     Padding="8,0,8,8">
              <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                  <Setter Property="Padding" Value="0"/>
                  <Setter Property="Margin" Value="0,1"/>
                  <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                  <Setter Property="Background" Value="Transparent"/>
                  <Setter Property="Template">
                    <Setter.Value>
                      <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter/>
                      </ControlTemplate>
                    </Setter.Value>
                  </Setter>
                </Style>
              </ListBox.ItemContainerStyle>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="64"/>
                      <ColumnDefinition Width="52"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding TimeText}"
                               Foreground="#6D7D90" VerticalAlignment="Top"/>
                    <TextBlock x:Name="LevelText" Grid.Column="1" Text="{Binding Level}"
                               FontWeight="SemiBold" VerticalAlignment="Top"/>
                    <TextBlock Grid.Column="2" Text="{Binding Message}"
                               Foreground="#C9D4E0" TextWrapping="Wrap"/>
                  </Grid>
                  <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Level}" Value="INFO">
                      <Setter TargetName="LevelText" Property="Foreground" Value="#5BA3E6"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Level}" Value="WARN">
                      <Setter TargetName="LevelText" Property="Foreground" Value="#E6B450"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Level}" Value="ERROR">
                      <Setter TargetName="LevelText" Property="Foreground" Value="#E06C75"/>
                    </DataTrigger>
                  </DataTemplate.Triggers>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</Window>
