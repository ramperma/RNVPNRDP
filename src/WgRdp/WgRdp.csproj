<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Platforms>AnyCPU;x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>WgRdp</AssemblyName>
    <RootNamespace>WgRdp</RootNamespace>
    <Version>1.0.0</Version>
    <Product>WG-RDP</Product>
    <AssemblyTitle>WG-RDP</AssemblyTitle>
    <Description>Acceso remoto por WireGuard y Escritorio remoto</Description>
    <Company>WG-RDP</Company>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- Permite compilar en Linux/macOS; el binario solo funciona en Windows -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- El MSI de WireGuard y el .conf por defecto se copian junto al exe -->
    <SetupAssetsDir>..\..\assets\</SetupAssetsDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- Evita ambigüedades WPF vs WinForms con los usings implícitos -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(SetupAssetsDir)wireguard\**\*" CopyToOutputDirectory="PreserveNewest"
          Link="Setup\wireguard\%(RecursiveDir)%(Filename)%(Extension)" Pack="false" />
    <None Include="$(SetupAssetsDir)default.conf.example" CopyToOutputDirectory="PreserveNewest"
          Link="Setup\default.conf.example" Pack="false" />
  </ItemGroup>

</Project>
